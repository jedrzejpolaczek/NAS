{
    "log_dir": "logs",
    "experiments": [
        {
            "experiment_name": "Grid search for Random Forest Classifier on Iris dataset",
            "optimizer": {
                "name": "grid_search",
                "config": {
                    "param_grid": {
                        "n_estimators": [10, 50],
                        "max_depth": [3, 5],
                        "min_samples_split": [2, 4]
                    },
                    "cv": 2,
                    "scoring": "accuracy"
                }
            },
            "model": {
                "name": "random_forest_classifier",
                "config": {
                    "n_estimators": 50,
                    "max_depth": 5,
                    "min_samples_split": 2
                },
                "evaluation": {
                    "average": "binary"
                }
            },
            "dataset": {
                "name": "tabular_data",
                "path": "data/raw/tabular_data",
                "file_name": "iris_dataset.csv",
                "dataset_name": "iris",
                "config": {
                    "test_size": 0.2,
                    "validation_size": 0.2
                }
            }
        }
    ]
}
