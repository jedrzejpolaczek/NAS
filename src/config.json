{
    "data_path": "data/example_dataset.csv",
    "log_dir": "logs/",
    "test_size": 0.2,
    "experiments": [
        {
            "optimizer": {
                "name": "grid_search",
                "config": {
                    "param_grid": {
                        "n_estimators": [100, 200],
                        "max_depth": [3, 5, 10]
                    },
                    "param_distributions": {
                        "C": [0.1, 1, 10],
                        "gamma": [0.001, 0.01, 0.1]
                    },
                    "cv": 3
                }
            },
            "dataset": {
                "name": "tabular_data",
                "config": {
                    "test_size": 0.2,
                    "validation_size": 0.2
                }
            },
            "model": {
                "name": "random_forest",
                "config": {
                    "n_iter": 10
                }
            }
        },
        {
            "optimizer": {
                "name": "random_search",
                "config": {
                    "param_grid": {
                        "n_estimators": [100, 200],
                        "max_depth": [3, 5, 10]
                    },
                    "param_distributions": {
                        "C": [0.1, 1, 10],
                        "gamma": [0.001, 0.01, 0.1]
                    },
                    "cv": 3
                }
            },
            "dataset": {
                "name": "tabular_data",
                "config": {
